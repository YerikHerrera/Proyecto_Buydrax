# Copia este archivo a .env y completa los valores.
# NUNCA subas el archivo .env real al repositorio.

# PostgreSQL (obligatorio)
DATABASE_URL=postgresql://postgres:1234@localhost:5432/postgres

# JWT
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# App
APP_NAME=Buydrax API
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
